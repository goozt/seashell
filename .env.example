# ── Required ──────────────────────────────────────────────────────────────────

# Strong random secret for signing JWT tokens
JWT_SECRET=change-me-very-long-random-string

# Super admin account credentials (created automatically on first start)
SUPERADMIN_PASSWORD=change-me-superadmin-password
SUPERADMIN_EMAIL=superadmin@seashell.local

# Shared secret that authenticates P2P requests between nodes.
# MUST be the same value on every node in the network.
NODE_SECRET=change-me-p2p-secret

# This node's publicly reachable base URL (no trailing slash)
NODE_URL=https://primary.example.com

# ── Node role ─────────────────────────────────────────────────────────────────

# Set IS_PRIMARY=true on the first / genesis node only.
IS_PRIMARY=true

# On secondary nodes, point to the primary node URL and set IS_PRIMARY=false:
# IS_PRIMARY=false
# PRIMARY_NODE_URL=https://primary.example.com

# ── Optional ──────────────────────────────────────────────────────────────────

PORT=8080
UI_PORT=3000
DB_PATH=./db
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Full URL of the API (used by the Next.js UI)
API_URL=http://localhost:8080
